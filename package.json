{
  "name": "mw-credit-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode synthetic --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --mode synthetic",
    "start": "node services/api/server.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "build:live-dev": "tsc --noEmit && vite build --mode live-dev",
    "dev:live-dev": "vite --mode live-dev --host 127.0.0.1",
    "start:read-dev": "node services/api/dev-read-server.mjs"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.8.0",
    "@google-cloud/secret-manager": "7.1.1",
    "@google-cloud/storage": "8.2.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}

{
  "name": "mw-credit-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode synthetic --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.services.json && tsc -p tsconfig.e2e.json",
    "build": "npm run typecheck && vite build --mode synthetic",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && vite build --mode live-dev && npm test",
    "check:evidence": "node scripts/check-binary-evidence.mjs",
    "build:live-dev": "tsc --noEmit && vite build --mode live-dev",
    "dev:live-dev": "vite --mode live-dev --host 127.0.0.1"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.8.0",
    "@google-cloud/storage": "8.2.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.1.0",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase": "12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}

<mxCell id="freeze" value="2  Freeze allocation plan&#xa;Newest charge date / ordinal first&#xa;Interest before principal per Charge" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#e4f5f1;strokeColor=#278775;fontColor=#17324d;fontSize=15;fontFamily=Helvetica;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="465" width="290" height="100" as="geometry"/></mxCell>

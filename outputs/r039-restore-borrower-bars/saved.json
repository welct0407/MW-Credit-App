{
  "dashboard": 3,
  "tab": 104,
  "questions": [
    {
      "id": 285,
      "name": "Current principal by borrower",
      "display": "row",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "type": "text",
                "id": "bp-population",
                "name": "population",
                "display-name": "Population",
                "default": "All with loan history"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), cohort AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE loan_count>0 AND ([[{{population}} --]] 'All with loan history'\n='All with loan history' OR [[{{population}} --]] 'All with loan history'\n='Currently active' AND has_active_loan OR [[{{population}} --]] 'All with loan history'\n='Currently inactive' AND NOT has_active_loan)), ranked AS (SELECT *,row_number() OVER(ORDER BY outstanding_principal DESC NULLS LAST,borrower_id) rank FROM cohort), groups AS (SELECT CASE WHEN rank<=10 THEN borrower_id END id,CASE WHEN rank<=10 THEN borrower_label ELSE 'Others' END label,CASE WHEN bool_and(outstanding_principal IS NOT NULL) THEN sum(outstanding_principal) END amount,min(rank) rank FROM ranked GROUP BY 1,2)\n SELECT label AS \"Borrower\",amount AS \"Amount ฿\",id AS \"Borrower ID\" FROM groups ORDER BY rank"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "graph.show_values": true,
        "graph.show_legend": false,
        "graph.missing": "none",
        "graph.y_axis.auto_split": false,
        "graph.metrics": [
          "Amount ฿"
        ],
        "graph.label_value_formatting": "compact",
        "graph.colors": [
          "#178F8A",
          "#7472BE",
          "#D6816B",
          "#24435A",
          "#D4AD60",
          "#9CA3AF"
        ],
        "graph.show_dots": false,
        "column_settings": {
          "[\"name\",\"Amount ฿\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false
          }
        },
        "graph.dimensions": [
          "Borrower"
        ],
        "stackable.stack_type": null
      }
    },
    {
      "id": 286,
      "name": "Period interest by borrower",
      "display": "row",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "widget-type": "date/all-options",
                "id": "bp-period",
                "name": "period",
                "display-name": "Activity period",
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Date",
                    "lib/uuid": "51cc4ada-11ce-4656-b56f-66f3a55dde08",
                    "effective-type": "type/Date"
                  },
                  82
                ],
                "alias": "d.\"Date\""
              },
              {
                "type": "text",
                "id": "bp-population",
                "name": "population",
                "display-name": "Population",
                "default": "All with loan history"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), selected AS (SELECT d.\"Date\" FROM (SELECT generate_series(DATE '1900-01-01',DATE '2199-12-31',interval '1 day')::date \"Date\") d WHERE [[{{period}} --]] d.\"Date\" BETWEEN (SELECT today-30 FROM clock) AND (SELECT today-1 FROM clock)\n), bounds AS (SELECT min(\"Date\") starts,max(\"Date\") ends,count(*) days,count(*)>0 AND count(*)=max(\"Date\")-min(\"Date\")+1 AND max(\"Date\")<=(SELECT today FROM clock) valid FROM selected), cohort AS (SELECT p.* FROM bounds b CROSS JOIN LATERAL public.reporting_borrower_period_v1(b.starts,b.ends,[[{{population}} --]] 'All with loan history'\n) p WHERE b.valid), ranked AS (SELECT *,interest_rank rank FROM cohort), groups AS (SELECT CASE WHEN rank<=10 THEN borrower_id END id,CASE WHEN rank<=10 THEN borrower_label ELSE 'Others' END label,CASE WHEN bool_and(interest_received IS NOT NULL) THEN sum(interest_received) END amount,min(rank) rank FROM ranked GROUP BY 1,2)\n SELECT label AS \"Borrower\",amount AS \"Amount ฿\",id AS \"Borrower ID\" FROM groups ORDER BY rank"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "graph.show_values": true,
        "graph.show_legend": false,
        "graph.missing": "none",
        "graph.y_axis.auto_split": false,
        "graph.metrics": [
          "Amount ฿"
        ],
        "graph.label_value_formatting": "compact",
        "graph.colors": [
          "#178F8A",
          "#7472BE",
          "#D6816B",
          "#24435A",
          "#D4AD60",
          "#9CA3AF"
        ],
        "graph.show_dots": false,
        "column_settings": {
          "[\"name\",\"Amount ฿\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false
          }
        },
        "graph.dimensions": [
          "Borrower"
        ],
        "stackable.stack_type": null
      }
    }
  ],

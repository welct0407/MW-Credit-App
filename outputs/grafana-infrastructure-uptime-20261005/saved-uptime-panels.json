{
  "dashboard": "mw-resource-performance",
  "timezone": "Asia/Singapore",
  "elements": {
    "panel-128": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "mw-gcp-monitoring"
                    },
                    "group": "yesoreyeram-infinity-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "columns": [
                        {
                          "selector": "UptimeText",
                          "text": "Uptime",
                          "type": "string"
                        }
                      ],
                      "format": "table",
                      "parser": "jq-backend",
                      "root_selector": "if .error then error(\"Uptime query failed\") elif .nextPageToken then error(\"Truncated uptime response\") else\n  (.timeSeries // []) as $series |\n  if ($series|length)>1 then error(\"Ambiguous VM uptime series\")\n  elif ($series|length)==0 then {Uptime:null}\n  elif $series[0].metric.type!=\"compute.googleapis.com/instance/uptime_total\" or\n    $series[0].resource.type!=\"gce_instance\" or\n    $series[0].resource.labels.project_id!=\"clever-oasis-508610-n7\" or\n    $series[0].resource.labels.instance_id!=\"8223265527494214160\" or\n    $series[0].resource.labels.zone!=\"asia-southeast1-a\"\n  then error(\"Unexpected uptime resource\") else\n    [$series[0].points[]?] | sort_by(.interval.endTime) | last as $p |\n    (try ($p.interval.endTime|sub(\"[.][0-9]+Z$\";\"Z\")|fromdateiso8601) catch null) as $t |\n    (try ($p.value.int64Value|tonumber) catch null) as $v |\n    {Uptime:(if $t!=null and now-$t<=360 and $t-now<=120 and\n      $v!=null and ($v|type)==\"number\" and $v>=0 and ($v|floor)==$v\n      then $v else null end)}\n  end end | . + {UptimeText:(if .Uptime==null then null else\n  (.Uptime/60|floor) as $m | (($m/1440|floor)|tostring)+\"d \"+\n  (\"0\"+((($m%1440)/60|floor)|tostring)|.[-2:])+\"h \"+\n  (\"0\"+(($m%60)|tostring)|.[-2:])+\"m\" end)}",
                      "source": "url",
                      "type": "json",
                      "url": "https://monitoring.googleapis.com/v3/projects/clever-oasis-508610-n7/timeSeries?filter=metric.type%20%3D%20%22compute.googleapis.com%2Finstance%2Fuptime_total%22%20AND%20resource.type%20%3D%20%22gce_instance%22%20AND%20resource.labels.project_id%20%3D%20%22clever-oasis-508610-n7%22%20AND%20resource.labels.instance_id%20%3D%20%228223265527494214160%22%20AND%20resource.labels.zone%20%3D%20%22asia-southeast1-a%22&interval.startTime=${__timeFrom:date:iso}&interval.endTime=${__timeTo:date:iso}&pageSize=100000",
                      "url_options": {
                        "method": "GET"
                      }
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Elapsed time since Compute Engine VM start, shown in days, hours and minutes. Source: uptime_total GAUGE for vm-mw-credit-agent, sampled every 60 seconds with up to 120 seconds visibility delay. This is VM-start uptime, not service availability or guaranteed guest-reboot age. Uses the latest raw sample without extrapolation. Samples older than 6 minutes, more than 2 minutes in the future, missing or invalid are Unknown. Query errors remain visible. Historical ranges excluding fresh data are Unknown. Display floors to whole minutes; raw seconds retained internally.",
        "id": 128,
        "links": [],
        "title": "",
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
          "spec": {
            "fieldConfig": {
              "defaults": {
                "color": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                },
                "decimals": 0,
                "displayName": "Debian VM",
                "min": 0,
                "noValue": "Unknown",
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 80
                    }
                  ]
                },
                "unit": "string"
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "justifyMode": "center",
              "legend": {
                "calcs": [
                  "lastNotNull",
                  "max"
                ],
                "displayMode": "table",
                "placement": "bottom"
              },
              "orientation": "vertical",
              "percentChangeColorMode": "standard",
              "reduceOptions": {
                "calcs": [
                  "last"
                ],
                "fields": "/.*/",
                "values": true
              },
              "showPercentChange": false,
              "text": {
                "titleSize": 12,
                "valueSize": 18
              },
              "textMode": "value_and_name",
              "tooltip": {
                "mode": "multi",
                "sort": "desc"
              },
              "wideLayout": true
            }
          },
          "version": "13.3.0-36978054224"
        }
      }
    },
    "panel-129": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "mw-gcp-monitoring"
                    },
                    "group": "yesoreyeram-infinity-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "columns": [
                        {
                          "selector": "UptimeText",
                          "text": "Uptime",
                          "type": "string"
                        }
                      ],
                      "format": "table",
                      "parser": "jq-backend",
                      "root_selector": "if .error then error(\"SQL uptime query failed\") elif .nextPageToken then error(\"Truncated SQL uptime response\") else\n  (.timeSeries // []) as $s |\n  if any($s[]; .metric.type!=\"custom.googleapis.com/mw_resource_monitoring/worker_timing\" or\n      .metric.labels.component!=\"cloud_sql_prod\" or .resource.type!=\"gce_instance\" or\n      .resource.labels.project_id!=\"clever-oasis-508610-n7\" or .resource.labels.instance_id!=\"8223265527494214160\" or\n      .resource.labels.zone!=\"asia-southeast1-a\" or\n      (.metric.labels.field!=\"status\" and .metric.labels.field!=\"uptime_seconds\"))\n  then error(\"Unexpected SQL uptime resource\") else\n    [$s[]|{field:.metric.labels.field,p:(.points|sort_by(.interval.endTime)|last)}] as $rows |\n    if ([$rows[]|.field]|unique|length)!=($rows|length) then error(\"Ambiguous SQL uptime fields\") else\n      ($rows|map(select(.field==\"status\"))|first|.p) as $p |\n      ($rows|map(select(.field==\"uptime_seconds\"))|first|.p) as $u |\n      (try ($p.interval.endTime|sub(\"[.][0-9]+Z$\";\"Z\")|fromdateiso8601) catch null) as $t |\n      (try ($p.value.int64Value|tonumber) catch null) as $status |\n      (try ($u.value.int64Value|tonumber) catch null) as $v |\n      {Uptime:(if $t!=null and now-$t<=360 and $t-now<=120 and $status==1 and\n        $u.interval.endTime==$p.interval.endTime and $v!=null and $v>=0 and ($v|floor)==$v\n        then $v else null end)}\n    end\n  end end | . + {UptimeText:(if .Uptime==null then null else\n  (.Uptime/60|floor) as $m | (($m/1440|floor)|tostring)+\"d \"+\n  (\"0\"+((($m%1440)/60|floor)|tostring)|.[-2:])+\"h \"+\n  (\"0\"+(($m%60)|tostring)|.[-2:])+\"m\" end)}",
                      "source": "url",
                      "type": "json",
                      "url": "https://monitoring.googleapis.com/v3/projects/clever-oasis-508610-n7/timeSeries?filter=metric.type%20%3D%20%22custom.googleapis.com%2Fmw_resource_monitoring%2Fworker_timing%22%20AND%20metric.labels.component%20%3D%20%22cloud_sql_prod%22%20AND%20resource.type%20%3D%20%22gce_instance%22%20AND%20resource.labels.project_id%20%3D%20%22clever-oasis-508610-n7%22%20AND%20resource.labels.instance_id%20%3D%20%228223265527494214160%22%20AND%20resource.labels.zone%20%3D%20%22asia-southeast1-a%22&interval.startTime=${__timeFrom:date:iso}&interval.endTime=${__timeTo:date:iso}&pageSize=100000",
                      "url_options": {
                        "method": "GET"
                      }
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "PostgreSQL server uptime for shared PROD and DEV Cloud SQL instance appsheet-pg-prod-20260914. Read through the existing least-privilege reporting connection to loan_manager_prod and Cloud SQL Auth Proxy. Elapsed seconds since pg_postmaster_start_time(), resetting on server restart or failover; not Cloud SQL allocation age or an availability percentage. Existing Debian collector cadence is 120 seconds after completion. Fresh successful status and uptime must share a timestamp; older than 6 minutes, more than 2 minutes future, missing, invalid or failed observations are Unknown. Errors remain visible. Display floors to whole minutes as days, hours and minutes; raw seconds retained internally. No extrapolation.",
        "id": 129,
        "links": [],
        "title": "",

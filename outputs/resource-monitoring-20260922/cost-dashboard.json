      "options": {
        "footer": {
          "show": false
        },
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 201,
      "targets": [
        {
          "root_selector": "if (.jobComplete != true) then error(\"Billing query is still running; refresh later\") elif .pageToken then error(\"Billing result truncated; shorten time range\") else .rows[]? | {Date:(if .f[0].v == null then null else ((.f[0].v|tonumber)*1000) end),Gross:(.f[1].v|if .==null then null else tonumber end),Credits:(.f[2].v|if .==null then null else tonumber end),Net:(.f[3].v|if .==null then null else tonumber end),Service:.f[4].v,Resource:.f[5].v,Currency:.f[6].v} end",
          "source": "url",
          "parser": "jq-backend",
          "url": "https://bigquery.googleapis.com/bigquery/v2/projects/clever-oasis-508610-n7/queries",
          "columns": [
            {
              "text": "Date",
              "selector": "Date",
              "type": "timestamp_epoch"
            },
            {
              "text": "Gross",
              "selector": "Gross",
              "type": "number"
            },
            {
              "text": "Credits",
              "selector": "Credits",
              "type": "number"
            },
            {
              "text": "Net",
              "selector": "Net",
              "type": "number"
            },
            {
              "text": "Service",
              "selector": "Service",
              "type": "string"
            },
            {
              "text": "Resource",
              "selector": "Resource",
              "type": "string"
            },
            {
              "text": "Currency",
              "selector": "Currency",
              "type": "string"
            }
          ],
          "format": "table",
          "refId": "A",
          "url_options": {
            "data": "{\"timeoutMs\":20000,\"query\":\"DECLARE export_table STRING;\\nSET export_table=(SELECT table_name FROM `clever-oasis-508610-n7.mw_cloud_billing.INFORMATION_SCHEMA.TABLES` WHERE STARTS_WITH(table_name,'gcp_billing_export_resource_v1_') ORDER BY table_name LIMIT 1);\\nIF export_table IS NULL THEN\\n SELECT CAST(NULL AS TIMESTAMP) AS Date, CAST(NULL AS FLOAT64) AS Gross, CAST(NULL AS FLOAT64) AS Credits, CAST(NULL AS FLOAT64) AS Net, 'Awaiting first billing export' AS Service, '' AS Resource, 'SGD' AS Currency;\\nELSE\\n EXECUTE IMMEDIATE FORMAT('''SELECT TIMESTAMP(DATE(usage_start_time,'Asia/Bangkok'),'Asia/Bangkok') AS Date, SUM(cost) AS Gross, SUM(IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c),0)) AS Credits, SUM(cost+IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c),0)) AS Net, service.description AS Service, COALESCE(NULLIF(resource.name,''),'Unallocated / service-level') AS Resource, currency AS Currency FROM `clever-oasis-508610-n7.mw_cloud_billing.%s` WHERE project.id='clever-oasis-508610-n7' AND usage_start_time >= TIMESTAMP('${__timeFrom:date:iso}') AND usage_start_time < TIMESTAMP('${__timeTo:date:iso}') GROUP BY Date, Service, Resource, Currency ORDER BY Date''',export_table);\\nEND IF;\",\"useLegacySql\":false,\"maximumBytesBilled\":\"100000000\",\"maxResults\":10000,\"useQueryCache\":true,\"location\":\"US\"}",
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json"
          },
          "hide": false,
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "mw-gcp-monitoring"
          },
          "type": "json"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "h": 9,
        "w": 24

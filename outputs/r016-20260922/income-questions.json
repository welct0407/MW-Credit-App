  {
    "key": "holders",
    "name": "Who holds the business cash? · period end",
    "display": "row",
    "native_select": "SELECT a.\"Cash Holder ID\",a.\"Cash Holder\",CASE WHEN bool_and(a.\"Current Balance\" IS NOT NULL) THEN sum(a.\"Business Cash Held\") END AS \"Business Cash Held\" FROM statement s JOIN {{model:cash-account-daily}} a ON a.\"Date\"=s.\"Period End\" GROUP BY 1,2 ORDER BY 3 DESC",
    "description": "Selected-period result from the shared Income statement period snippet and Daily Income Ledger. Existing FIFO allocation is centralized; no financial write.",

  {
    "key": "bridge",
    "name": "Income → retained profit · selected period",
    "display": "waterfall",
    "native_select": "SELECT v.movement AS \"Movement\",v.amount AS \"Amount\" FROM statement s CROSS JOIN LATERAL (VALUES (1,'1 · Income',s.\"Operating Income\"),(2,'2 · Expenses',s.\"Operating Expenses\"),(3,'3 · Tommy draw',s.\"Tommy Draw\"),(4,'4 · Lisa draw',s.\"Lisa Draw\")) v(step,movement,amount) ORDER BY step",
    "description": "Selected-period result from the shared Income statement period snippet and Daily Income Ledger. Existing FIFO allocation is centralized; no financial write.",
    "settings": {
      "graph.dimensions": [
        "Movement"
      ],
      "graph.metrics": [
        "Amount"
      ],
      "graph.colors": [
        "#13855B",
        "#D1495B",
        "#267DCC"
      ],
      "graph.show_values": true,
      "graph.show_legend": false,
      "graph.show_dots": false,
      "graph.x_axis.title_enabled": false,
      "graph.y_axis.title_enabled": false,
      "graph.label_value_formatting": "compact",
      "column_settings": {
        "[\"name\",\"Amount\"]": {
          "number_style": "decimal",
          "decimals": 0,
          "number_separators": ".,"
        }
      },
      "waterfall.increase_color": "#13855B",
      "waterfall.decrease_color": "#D1495B",
      "waterfall.total_color": "#267DCC",
      "waterfall.show_total": true
    }
  },

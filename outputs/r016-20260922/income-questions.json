  {
    "key": "cash-bridge",
    "name": "Cash pool → business cash held · period end",
    "display": "waterfall",
    "native_select": "SELECT v.movement AS \"Movement\",v.amount AS \"Amount\" FROM statement s CROSS JOIN LATERAL (VALUES (1,'1 · Cash pool',s.\"Cash Pool Remaining\"),(2,'2 · Earlier retained profit',s.\"Earlier Retained Profit\"),(3,'3 · Selected-period retained profit',s.\"Unsettled Profit\"),(4,'4 · Advances',s.\"Advance Due\"),(5,'5 · Reconciliation difference',s.\"Cash Reconciliation Difference\")) v(step,movement,amount) WHERE s.\"Business Cash Held\" IS NOT NULL ORDER BY step",
    "description": "Selected-period result from the shared Income statement period snippet and Daily Income Ledger. Existing FIFO allocation is centralized; no financial write.",
    "settings": {

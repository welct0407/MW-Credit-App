      "seed": {
        "release": "R142",
        "native": 37,
        "verified": true,
        "note": "Deployed code 813462e7, catalogue revision 37 (R142). No DEV agent exists; the agent serves PROD only. /ready is on the VM and reaches drift through --observed."

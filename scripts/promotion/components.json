        "prod": {
          "kind": "cloud-sql",
          "database": "loan_manager_prod",
          "query": "max(version::int) from flyway_schema_history where success",
          "url": null,
          "credentialed": true
        }
      },
      "seed": {
        "release": "R140",
        "native": 145,
        "verified": true,
        "note": "V145 is the highest migration and the last one added (R140: V142 to V145)."

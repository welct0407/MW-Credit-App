{
  "schemaVersion": 1,
  "description": "Component registry (R144). Each component's version is the last Rnnn that changed it plus its native counter. Rnnn stays the one ecosystem number. Read by scripts/promotion/component-versions.mjs (derive, render, check-source, drift).",
  "releasePattern": "^R\\d{3}$",
  "seedAsOf": "R143",
  "fields": {
    "id": "Stable key, kebab-case.",
    "label": "Human name used in the rendered table and the Release body.",
    "kind": "app | api | schema | agent | monitoring | reporting | vendor.",
    "paths": "Git paths (files, directories or globs) whose change means this component changed. Compared between the previous Rnnn tag and the release commit. Absent when derive is set.",
    "derive": "generic-role: use genericRoleClosures/genericChangedRoles from deploy-business-hosting.mjs; requires role.",
    "role": "One of read, command, notify, jobs, chat (GENERIC_ROLES).",
    "native": "The component's own counter: flyway | catalogue-revision | image-digest | hosting-version | vendor | null.",
    "nativeSource": "How the native value is read from the source tree at the release commit (file plus pattern or json pointer). Absent when the counter only exists live.",
    "stamp": "Where the release is written for components that cannot self-report: grafana-tag (dashboard JSON tags contain release:Rnnn) or metabase-stamp (Stamp-Release.mjs).",
    "live": "Per environment {dev, prod}: null when the environment has none. kind: build-version-json | health-json | ready-json | grafana-api | metabase-api | cloud-run | cloud-sql | hosting. url is set only where public; credentialed=true means the fact reaches drift only through --observed. field names the JSON member carrying the release (and commit, native where present).",
    "seed": "Facts as of seedAsOf: release (last Rnnn that changed the component, from tags and records) and native (value, or {dev, prod} when it differs by environment, null when only live). verified=false marks a seed taken from records only."
  },
  "components": [
    {
      "id": "pwa",
      "label": "PWA frontend",
      "kind": "app",
      "paths": [
        "apps/pwa",
        "public",
        "index.html",
        "vite.config.ts",
        "scripts/hosting-headers.mjs",
        "scripts/build-live-dev.mjs"
      ],
      "native": "hosting-version",
      "live": {
        "dev": {
          "kind": "build-version-json",
          "url": "https://dev-lm.mw-credit.com/build-version.json",
          "field": "release",
          "commit": "commit",
          "credentialed": false,
          "nativeKind": "hosting",
          "nativeCredentialed": true
        },
        "prod": {
          "kind": "build-version-json",
          "url": "https://lm.mw-credit.com/build-version.json",
          "field": "release",
          "commit": "commit",
          "credentialed": false,
          "nativeKind": "hosting",
          "nativeCredentialed": true
        }
      },
      "seed": {
        "release": "R142",
        "native": null,
        "verified": true,
        "note": "Hosting version pins live only in Environment_Inventory.md; read live through the Hosting API."
      }
    },
    {
      "id": "api-read",
      "label": "API read service",
      "kind": "api",
      "derive": "generic-role",
      "role": "read",
      "native": "image-digest",
      "live": {
        "dev": {
          "kind": "health-json",
          "service": "mw-credit-app-read-dev",
          "path": "/health",
          "url": "https://mw-credit-app-read-dev-pvrgvyg3oq-as.a.run.app/health",
          "field": "release",
          "commit": "commit",
          "credentialed": false,
          "nativeKind": "cloud-run",
          "nativeCredentialed": true
        },
        "prod": {
          "kind": "health-json",
          "service": "mw-credit-app-read-prod",
          "path": "/health",
          "url": "https://mw-credit-app-read-prod-pvrgvyg3oq-as.a.run.app/health",
          "field": "release",
          "commit": "commit",
          "credentialed": false,
          "nativeKind": "cloud-run",
          "nativeCredentialed": true
        }
      },
      "seed": {
        "release": "R141",
        "native": null,
        "verified": true,
        "note": "Image digest and revision live only in Environment_Inventory.md; Cloud Run URL read with gcloud run services describe."
      }
    },

      "id": "schema",
      "label": "Database schema (loan_manager)",
      "kind": "schema",
      "paths": [
        "database/migrations"
      ],
      "native": "flyway",
      "nativeSource": {
        "file": "database/migrations",
        "pattern": "highest V<n>__ file name"
      },
      "live": {
        "dev": {
          "kind": "cloud-sql",
          "database": "loan_manager_dev",
          "query": "max(version::int) from flyway_schema_history where success",

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "/apps/pwa/src/*": [
        "./apps/pwa/src/*"
      ],
      "/tests/e2e/*": [
        "./tests/e2e/*"
      ]
    }
  },

        </mxCell>
        <mxCell id="status" value="STATUS: LIVE  |  Return to all services" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1" link="data:page/id,overview">
          <mxGeometry x="40" y="105" width="1320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="1. Meta message → hooks.mw-credit.com/instagram" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="2. Cloudflare tunnel → Debian loopback receiver" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="306" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="3. Verify signature and expected Instagram account" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="432" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="4. Durably capture ID, sender, time and image references" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="558" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="5. Deduplicate retries, then acknowledge HTTP request" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="684" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="6. Receipt worker consumes captured events separately" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="exceptions" value="DECISIONS / EXCEPTIONS&#10;&#10;Invalid signature → reject.&#10;Duplicate event → no second job.&#10;Ordinary text/audio/video → no reply.&#10;Operator-selected history is a separate input and is not labelled webhook evidence." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="180" width="460" height="690" as="geometry" />
        </mxCell>
        <mxCell id="scripts" value="IMPLEMENTING SCRIPTS / RUNTIME&#10;server.py · webhook.py · journal.py&#10;mw-instagram-webhook.service · mw-cloudflared-instagram.service" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

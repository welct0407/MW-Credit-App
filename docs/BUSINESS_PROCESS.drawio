          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="4. Run fixed SELECT queries in read-only transactions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

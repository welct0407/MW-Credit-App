        <mxCell id="exceptions" value="DECISIONS / EXCEPTIONS&#10;&#10;PROD APIs enabled directly by owner authority, outside releases. DEV unchanged.&#10;Current client is Find-only. Connection setup does not enable arbitrary writes.&#10;Keys stay under /etc/mw-integration-agent.&#10;Do not assume API Enable survives App Upgrade; preservation is not explicitly guaranteed in the vendor guide." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="180" width="460" height="690" as="geometry" />

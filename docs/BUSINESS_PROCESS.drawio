          <mxGeometry x="40" y="105" width="1320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="1. 20-second timer → acquire single-worker lock" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

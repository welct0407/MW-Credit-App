          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="6. Reserve receipt keys; queue localized partner notification" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="810" width="740" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#607d8b;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="exceptions" value="DECISIONS / EXCEPTIONS&#10;&#10;Today/yesterday Bangkok only.&#10;Active receiving account; primary or alternative number.&#10;Reference/image duplicate → stop.&#10;Nonreceipt or disabled/unmapped borrower → ignore.&#10;Invalid receipt → REVIEW.&#10;CURRENT: summary only; no payment write or group reply.&#10;receipt-prepare accepts borrower/date/message parameters and reuses the same extraction and rules." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

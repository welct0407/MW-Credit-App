        </mxCell>
        <mxCell id="exceptions" value="DECISIONS / EXCEPTIONS&#10;&#10;SELECT and TEMP privileges only; no durable DML/schema changes.&#10;Both apps share PROD database, with distinct API keys.&#10;Integrity/accounting triggers are never disabled.&#10;No unrestricted production export goes into Git." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f7fa;strokeColor=#78909c;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

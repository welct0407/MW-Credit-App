          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="3. Load protected credential without exposing it to Codex" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eaf6;strokeColor=#5c6bc0;strokeWidth=2;fontColor=#243447;fontSize=18;spacing=14;" vertex="1" parent="1">

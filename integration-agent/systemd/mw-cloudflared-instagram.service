[Unit]
Description=Cloudflare tunnel for MW Instagram webhook
After=network-online.target mw-instagram-webhook.service
Wants=network-online.target

[Service]
Type=simple
User=mwagent
Group=mwagent
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/mw-integration-agent/secrets/cloudflare-token.txt
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AGT-HOST-03: cloudflared opens AF_INET/AF_INET6 (edge QUIC/HTTP2, DNS, origin, ICMPv6 proxy) and
# AF_NETLINK/NETLINK_ROUTE (interface enumeration at start; strace of 2026.9.1); AF_UNIX for local resolver/journal.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

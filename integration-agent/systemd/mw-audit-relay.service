[Unit]
Description=M&W transaction audit outbox relay
After=network-online.target cloud-sql-auth-proxy.service
Requires=cloud-sql-auth-proxy.service

[Service]
Type=oneshot
User=mwagent
Group=mwagent
UMask=0077
WorkingDirectory=/var/lib/mw-integration-agent
ExecStart=/opt/mw-integration-agent/.venv/bin/mw-integration-agent audit-relay --config /etc/mw-integration-agent/config.json --catalogue /etc/mw-integration-agent/service-catalogue.json
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mw-integration-agent

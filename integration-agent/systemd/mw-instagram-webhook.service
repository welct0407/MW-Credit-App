[Unit]
Description=MW Integration Agent signed Instagram webhook receiver
After=network-online.target cloud-sql-auth-proxy.service
Wants=network-online.target cloud-sql-auth-proxy.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mwagent
Group=mwagent
UMask=0077
Environment=HOME=/var/lib/mw-integration-agent
WorkingDirectory=/var/lib/mw-integration-agent
ExecStart=/opt/mw-integration-agent/.venv/bin/mw-integration-agent serve-webhook --config /etc/mw-integration-agent/config.json --catalogue /etc/mw-integration-agent/service-catalogue.json
# Non-fatal gate: "active" waits until /ready or 30 s; a long proxy outage cannot reach the start limit.
ExecStartPost=-/opt/mw-integration-agent/.venv/bin/mw-integration-agent receiver-ready --config /etc/mw-integration-agent/config.json --wait 30
TimeoutStartSec=45s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/mw-integration-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

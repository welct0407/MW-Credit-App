[Unit]
Description=MW Muse secret broker (read-only Secret Manager, loopback 127.0.0.1:8793 behind the Cloudflare tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mwagent
Group=mwagent
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/mw-muse-broker/muse_broker.py
Environment=MUSE_BROKER_PORT=8793
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=128M

[Install]
WantedBy=multi-user.target

[Unit]
Description=M&W Credit incoming receipt validation and Partner email summaries
After=network-online.target cloud-sql-auth-proxy.service mw-instagram-webhook.service
Wants=network-online.target cloud-sql-auth-proxy.service
# The receipt wake path can start this oneshot in bursts; a duplicate start returns already_running.
# Default start limits (5 per 10 s) would fail the path unit with start-limit-hit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=mwagent
Group=mwagent
UMask=0077
Environment=HOME=/var/lib/mw-integration-agent
WorkingDirectory=/var/lib/mw-integration-agent
ExecStart=/opt/mw-integration-agent/.venv/bin/mw-integration-agent receipt-cycle --config /etc/mw-integration-agent/config.json --catalogue /etc/mw-integration-agent/service-catalogue.json
TimeoutStartSec=40min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mw-integration-agent /etc/mw-integration-agent/secrets/outlook-email-oauth.json -/etc/mw-integration-agent/secrets/outlook-email-oauth.json.bak

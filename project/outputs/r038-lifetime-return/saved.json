    {
      "id": 314,
      "name": "Lifetime Interest Return on Principal Lent · top 8",
      "type": "question",
      "description": "R038. Lifetime interest return = all signed interest received / total original principal lent, active and closed loans, through current Bangkok date. Repeated lending counts each loan once. Gross interest before expenses/losses. Activity slicer ignored; population applies.",
      "display": "row",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "type": "text",
                "id": "r037-pop",
                "name": "population",
                "display-name": "Population",
                "default": "All with loan history"
              },
              {
                "type": "card",
                "id": "r037-model",
                "name": "#310",
                "display-name": "Borrower lifetime economics",
                "card-id": 310
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH cohort AS (SELECT * FROM {{#310}} m WHERE ([[{{population}} --]] 'All with loan history'\n='All with loan history' OR [[{{population}} --]] 'All with loan history'\n='Currently active' AND \"Has active loan\" OR [[{{population}} --]] 'All with loan history'\n='Currently inactive' AND NOT \"Has active loan\")) SELECT \"Borrower\",\"Lifetime interest return\",\"Borrower ID\",\"Lifetime interest received\",\"Total principal lent\" FROM cohort WHERE \"Lifetime interest return\" IS NOT NULL ORDER BY \"Lifetime interest return\" DESC,\"Borrower ID\" LIMIT 8"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },

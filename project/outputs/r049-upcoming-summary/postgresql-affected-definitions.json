        "acl": "{postgres=arwdDxtm/postgres}",
        "comment": "R048: read-only one borrower/date, first five distinct dates within existing three-month horizon; sum matches upcoming details.",
        "view_definition": " SELECT (((('ufs1:'::text || length(\"Ref Borrower\")) || ':'::text) || \"Ref Borrower\") || ':'::text) || to_char(\"Due Date\"::timestamp with time zone, 'YYYY-MM-DD'::text) AS \"Row ID\",\n    \"Ref Borrower\",\n    \"Due Date\",\n    sum(\"Amount Remaining\") AS \"Total Charge\",\n    \"As Of Date\"\n   FROM oltp_upcoming_charge_events_v1\n  WHERE \"Borrower Due Date Rank\" >= 1 AND \"Borrower Due Date Rank\" <= 5 AND \"Due Date\" <= \"Horizon End\"\n  GROUP BY \"Ref Borrower\", \"Due Date\", \"As Of Date\";",

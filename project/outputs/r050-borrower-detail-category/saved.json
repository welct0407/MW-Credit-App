{
  "question": {
    "id": 378,
    "name": "Borrower category · current BCG matrix",
    "description": "Current governed V3 BCG Matrix quadrant for the selected borrower. Emoji provides a visual cue while retaining the exact category label. Outside active cohort remains explicit. Ignores Detail activity dates.",
    "display": "scalar",
    "dataset_query": {
      "stages": [
        {
          "template-tags": [
            {
              "display-name": "Borrower",
              "id": "bp-borrower",
              "name": "borrower_id",
              "type": "text"
            }
          ],
          "lib/type": "mbql.stage/native",
          "native": "WITH chosen AS (SELECT borrower_id FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n) SELECT CASE m.quadrant\n WHEN 'Cash Cow' THEN '🐄 Cash Cow' WHEN 'Dog' THEN '🐕 Dog'\n WHEN 'Star' THEN '⭐ Star' WHEN 'Question Mark' THEN '❓ Question Mark'\n ELSE coalesce(m.quadrant,'Outside active cohort') END AS \"Borrower category\"\n FROM chosen c LEFT JOIN public.reporting_borrower_matrix_v3 m USING(borrower_id)"
        }
      ],
      "lib/type": "mbql/query",
      "database": 2
    },
    "visualization_settings": {
      "scalar.field": "Borrower category"
    }
  },

  "questions": [
    {
      "id": 313,
      "name": "Lifetime Effective Achieved Daily Interest Rate · top 8",
      "description": "R037. Overall borrower economics; population filter applies, activity date slicer does not. Lifetime rate uses completed Bangkok days and end-of-day outstanding principal. Gross interest before expenses. See chart context and handover.",
      "display": "row",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "type": "text",
                "id": "r037-pop",
                "name": "population",
                "display-name": "Population",
                "default": "All with loan history"
              },
              {
                "type": "card",
                "id": "r037-model",
                "name": "#310",
                "display-name": "Borrower lifetime economics",
                "card-id": 310
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH cohort AS (SELECT * FROM {{#310}} m WHERE ([[{{population}} --]] 'All with loan history'\n='All with loan history' OR [[{{population}} --]] 'All with loan history'\n='Currently active' AND \"Has active loan\" OR [[{{population}} --]] 'All with loan history'\n='Currently inactive' AND NOT \"Has active loan\")) SELECT \"Borrower\",\"Achieved daily rate\",\"Borrower ID\",\"Lifetime interest\",\"Principal days\",\"Active loan interest\",\"Principal outstanding\" FROM cohort WHERE \"Achieved daily rate\" IS NOT NULL ORDER BY \"Achieved daily rate\" DESC,\"Borrower ID\" LIMIT 8"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "graph.show_goal": false,
        "graph.show_values": true,
        "graph.show_legend": false,
        "graph.x_axis.title_enabled": true,
        "graph.goal_label": "100% coverage",
        "graph.x_axis.title_text": "Achieved interest · % per day",
        "graph.goal_value": 1,
        "graph.metrics": [
          "Achieved daily rate"
        ],
        "graph.colors": [
          "#7472BE"
        ],
        "column_settings": {
          "[\"name\",\"Achieved daily rate\"]": {
            "number_style": "percent",
            "decimals": 1,
            "number_separators": ".,"
          }
        },
        "graph.dimensions": [
          "Borrower"
        ],
        "stackable.stack_type": null
      }
    },
    {
      "id": 289,
      "name": "Borrower comparison · click a name for Detail",
      "description": "R040 comparison: current/selected-period activity plus lifetime achieved daily rate (interest through yesterday / end-of-day principal-days) and lifetime interest return (interest through today / total original principal lent). Lifetime columns ignore Activity dates; all retain the population filter. Click Borrower for Detail.",
      "display": "table",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "widget-type": "date/all-options",
                "id": "bp-period",
                "name": "period",
                "display-name": "Activity period",
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Date",
                    "lib/uuid": "0538ccbf-b6b3-4b48-819e-0c1d3e49124d",
                    "effective-type": "type/Date"
                  },
                  82
                ],
                "alias": "d.\"Date\""
              },
              {
                "type": "text",
                "id": "bp-population",
                "name": "population",
                "display-name": "Population",
                "default": "All with loan history"
              },
              {
                "type": "card",
                "id": "r040-model-310",
                "name": "#310",
                "display-name": "Borrower lifetime economics",
                "card-id": 310
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), selected AS (SELECT d.\"Date\" FROM (SELECT generate_series(DATE '1900-01-01',DATE '2199-12-31',interval '1 day')::date \"Date\") d WHERE [[{{period}} --]] d.\"Date\" BETWEEN (SELECT today-30 FROM clock) AND (SELECT today-1 FROM clock)\n), bounds AS (SELECT min(\"Date\") starts,max(\"Date\") ends,count(*) days,count(*)>0 AND count(*)=max(\"Date\")-min(\"Date\")+1 AND max(\"Date\")<=(SELECT today FROM clock) valid FROM selected), cohort AS (SELECT p.* FROM bounds b CROSS JOIN LATERAL public.reporting_borrower_period_v1(b.starts,b.ends,[[{{population}} --]] 'All with loan history'\n) p WHERE b.valid) SELECT c.borrower_label AS \"Borrower\",c.active_loans AS \"Active loans\",c.outstanding_principal AS \"Principal ฿\",c.principal_share AS \"Principal share\",c.interest_received AS \"Interest ฿\",e.\"Achieved daily rate\" AS \"Lifetime daily rate\",e.\"Lifetime interest return\" AS \"Lifetime interest return\",c.principal_issued AS \"Principal issued ฿\",c.loans_issued AS \"Loans issued\",coalesce(h.current_health_status,'Unavailable') AS \"Current health\",c.principal_returned AS \"Principal returned ฿\",c.loan_count AS \"Lifetime loans\",c.last_payment_date AS \"Last payment\",c.borrower_id AS \"Borrower ID\",b.starts::text AS \"Period start\",b.ends::text AS \"Period end\" FROM cohort c LEFT JOIN {{#310}} e ON e.\"Borrower ID\"=c.borrower_id LEFT JOIN public.reporting_borrower_payment_health_v1 h USING(borrower_id) CROSS JOIN bounds b ORDER BY c.principal_rank"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },

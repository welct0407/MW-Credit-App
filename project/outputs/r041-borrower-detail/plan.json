        "type": "native",
        "native": {
          "query": "WITH clock AS (SELECT public.olap_reporting_date() today), chosen AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n) SELECT CASE WHEN k.\"Row ID\" IS NULL THEN 'Loan key unavailable' ELSE coalesce(c.borrower_name,'Unknown borrower')||'-'||to_char(k.\"Principal Amount\"::numeric,'FM999,999,999,990.00')||'-'||to_char(k.\"Loan Date\",'DD/MM')||'-'||coalesce(to_char(k.\"Effective Daily Interest Rate\"::numeric*100,'FM999990.00')||'%','Unavailable') END AS \"Loan Key\",l.loan_date AS \"Loan date\",l.loan_type AS \"Loan type\",l.original_principal AS \"Original principal ฿\",l.outstanding_principal AS \"Current principal ฿\",l.due_date AS \"Due date\",l.daily_interest AS \"Daily interest ฿\",s.schedule_reason AS \"Schedule\",s.next_plan_due_date AS \"Next plan due\",s.next_plan_principal AS \"Next principal ฿\",s.next_plan_interest AS \"Next interest ฿\" FROM chosen c JOIN public.reporting_borrower_loan_facts_v1 l USING(borrower_id) LEFT JOIN public.olap_loans_analytics k ON k.\"Row ID\"=l.loan_id LEFT JOIN public.reporting_loan_schedule_health_v1 s USING(loan_id) WHERE l.is_active ORDER BY l.loan_date DESC,l.loan_id",

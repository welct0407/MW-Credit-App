    {
      "id": 290,
      "name": "Selected borrower · current position",
      "display": "table",
      "dataset_query": {
        "database": 2,
        "type": "native",
        "native": {
          "query": "WITH clock AS (SELECT public.olap_reporting_date() today), chosen AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n) SELECT borrower_label AS \"Borrower\",CASE WHEN has_active_loan THEN 'Active' ELSE 'Inactive' END AS \"Status\",CASE WHEN hidden_flag THEN 'Hidden in operational app' ELSE 'Visible' END AS \"Operational visibility\",first_loan_date AS \"First loan\",reporting_date AS \"As of\" FROM chosen",
          "template-tags": {
            "borrower_id": {
              "display-name": "Borrower",
              "id": "bp-borrower",
              "name": "borrower_id",
              "type": "text"
            }
          }
        }
      },
      "visualization_settings": {}
    },
    {
      "id": 301,
      "name": "Principal issued and returned",
      "display": "bar",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "widget-type": "date/all-options",
                "id": "bp-period",
                "name": "period",
                "display-name": "Activity period",
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Date",
                    "lib/uuid": "2692c48c-0fc9-4bd8-b370-046ec4202515",
                    "effective-type": "type/Date"
                  },
                  82
                ],
                "alias": "d.\"Date\""
              },
              {
                "display-name": "Borrower",
                "id": "bp-borrower",
                "name": "borrower_id",
                "type": "text"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), selected AS (SELECT d.\"Date\" FROM (SELECT generate_series(DATE '1900-01-01',DATE '2199-12-31',interval '1 day')::date \"Date\") d WHERE [[{{period}} --]] d.\"Date\" BETWEEN (SELECT today-30 FROM clock) AND (SELECT today-1 FROM clock)\n), bounds AS (SELECT min(\"Date\") starts,max(\"Date\") ends,count(*) days,count(*)>0 AND count(*)=max(\"Date\")-min(\"Date\")+1 AND max(\"Date\")<=(SELECT today FROM clock) valid FROM selected), chosen AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n), activity AS (SELECT a.* FROM public.reporting_borrower_activity_daily_v1 a JOIN chosen c USING(borrower_id) CROSS JOIN bounds b WHERE b.valid AND a.activity_date BETWEEN b.starts AND b.ends) SELECT CASE WHEN b.days<=60 THEN d.\"Date\" ELSE date_trunc('week',d.\"Date\")::date END AS \"Date\",CASE WHEN bool_and(a.activity_date IS NULL OR a.principal_issued IS NOT NULL) THEN sum(coalesce(a.principal_issued,0)) END AS \"Principal issued ฿\",CASE WHEN bool_and(a.activity_date IS NULL OR a.principal_returned IS NOT NULL) THEN sum(coalesce(a.principal_returned,0)) END AS \"Principal returned ฿\"\n FROM selected d CROSS JOIN chosen c CROSS JOIN bounds b LEFT JOIN activity a ON a.activity_date=d.\"Date\" WHERE b.valid GROUP BY 1 ORDER BY 1"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "graph.show_values": false,
        "graph.show_legend": true,
        "graph.missing": "none",
        "graph.y_axis.auto_split": false,
        "graph.metrics": [
          "Principal issued ฿",
          "Principal returned ฿"
        ],
        "graph.label_value_formatting": "compact",
        "graph.colors": [
          "#178F8A",
          "#7472BE",
          "#D6816B",
          "#24435A",
          "#D4AD60",
          "#9CA3AF"
        ],
        "graph.show_dots": false,
        "column_settings": {
          "[\"name\",\"Principal issued ฿\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false
          },
          "[\"name\",\"Principal returned ฿\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false
          }
        },
        "graph.dimensions": [
          "Date"
        ],
        "stackable.stack_type": null
      }
    },

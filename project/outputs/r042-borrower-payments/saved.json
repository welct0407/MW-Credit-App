  "questions": [
    {
      "id": 302,
      "name": "Interest received over time",
      "display": "bar",
      "description": "R035 additive borrower pages. Immutable borrower keys; Bangkok dates; current health from V41/V42. Signed receipts. No AppSheet/financial writes.",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "widget-type": "date/all-options",
                "id": "bp-period",
                "name": "period",
                "display-name": "Activity period",
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Date",
                    "lib/uuid": "2cb0df78-0a34-447c-8e5a-9c518b1aca71",
                    "effective-type": "type/Date"
                  },
                  82
                ],
                "alias": "d.\"Date\""
              },
              {
                "display-name": "Borrower",
                "id": "bp-borrower",
                "name": "borrower_id",
                "type": "text"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), selected AS (SELECT d.\"Date\" FROM (SELECT generate_series(DATE '1900-01-01',DATE '2199-12-31',interval '1 day')::date \"Date\") d WHERE [[{{period}} --]] d.\"Date\" BETWEEN (SELECT today-30 FROM clock) AND (SELECT today-1 FROM clock)\n), bounds AS (SELECT min(\"Date\") starts,max(\"Date\") ends,count(*) days,count(*)>0 AND count(*)=max(\"Date\")-min(\"Date\")+1 AND max(\"Date\")<=(SELECT today FROM clock) valid FROM selected), chosen AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n), activity AS (SELECT a.* FROM public.reporting_borrower_activity_daily_v1 a JOIN chosen c USING(borrower_id) CROSS JOIN bounds b WHERE b.valid AND a.activity_date BETWEEN b.starts AND b.ends) SELECT CASE WHEN b.days<=60 THEN d.\"Date\" ELSE date_trunc('week',d.\"Date\")::date END AS \"Date\",CASE WHEN bool_and(a.activity_date IS NULL OR a.interest_received IS NOT NULL) THEN sum(coalesce(a.interest_received,0)) END AS \"Interest ฿\"\n FROM selected d CROSS JOIN chosen c CROSS JOIN bounds b LEFT JOIN activity a ON a.activity_date=d.\"Date\" WHERE b.valid GROUP BY 1 ORDER BY 1"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "graph.show_values": false,
        "graph.show_legend": false,
        "graph.missing": "none",
        "graph.y_axis.auto_split": false,
        "graph.metrics": [
          "Interest ฿"
        ],
        "graph.label_value_formatting": "compact",
        "graph.colors": [
          "#178F8A",
          "#7472BE",
          "#D6816B",
          "#24435A",
          "#D4AD60",
          "#9CA3AF"
        ],
        "graph.show_dots": false,
        "column_settings": {
          "[\"name\",\"Interest ฿\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false
          }
        },
        "graph.dimensions": [
          "Date"
        ],
        "stackable.stack_type": null
      }
    },
    {
      "id": 305,
      "name": "Loan history · lifetime",
      "display": "table",
      "description": "Lifetime signed interest received / original loan principal. Gross interest before expenses. <100% red; 100–200% inclusive orange; >200% green. Invalid/nonpositive original principal gives no percentage/color. Ignores activity dates.",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "display-name": "Borrower",
                "id": "bp-borrower",
                "name": "borrower_id",
                "type": "text"
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH clock AS (SELECT public.olap_reporting_date() today), chosen AS (SELECT * FROM public.reporting_borrower_directory_v1 WHERE borrower_id= [[{{borrower_id}} --]] '__select_borrower__'\n) SELECT CASE WHEN k.\"Row ID\" IS NULL THEN 'Loan key unavailable' ELSE coalesce(c.borrower_name,'Unknown borrower')||'-'||to_char(k.\"Principal Amount\"::numeric,'FM999,999,999,990.00')||'-'||to_char(k.\"Loan Date\",'DD/MM')||'-'||coalesce(to_char(k.\"Effective Daily Interest Rate\"::numeric*100,'FM999990.00')||'%','Unavailable') END AS \"Loan Key\",l.loan_date AS \"Loan date\",l.loan_type AS \"Loan type\",l.loan_status AS \"Status\",l.original_principal AS \"Original principal ฿\",l.outstanding_principal AS \"Current principal ฿\",l.principal_received AS \"Principal received ฿\",l.interest_received AS \"Interest received ฿\",CASE WHEN l.original_principal>0 THEN l.interest_received/l.original_principal END AS \"Profit / original principal\",l.close_date AS \"Close date\",l.defaulted AS \"Defaulted\",l.default_loss AS \"Recorded loss ฿\" FROM chosen c JOIN public.reporting_borrower_loan_facts_v1 l USING(borrower_id) LEFT JOIN public.olap_loans_analytics k ON k.\"Row ID\"=l.loan_id ORDER BY l.is_active DESC,l.loan_date DESC,l.loan_id"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },

            "lib/type": "mbql.stage/native",
            "native": "WITH statement AS ({{snippet: Cashflow statement period}}) SELECT t.\"Transaction Type\",sum(t.\"Money In\") AS \"Money In\",sum(t.\"Money Out\") AS \"Money Out\",sum(t.\"Net Movement\") AS \"Net Movement\" FROM statement s JOIN {{#190}} t ON t.\"Date\" BETWEEN s.\"Period Start\" AND s.\"Period End\" WHERE t.\"Scope ID\"={{cash_account}} AND s.\"Continuous Period\" GROUP BY 1 ORDER BY 1"

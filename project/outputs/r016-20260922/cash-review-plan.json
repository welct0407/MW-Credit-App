        "type": "native",
        "native": {
          "query": "SELECT d.\"Date\",d.\"Cash Pool Remaining\" AS \"Remaining lending capital\",d.\"Business Cash Held\"-d.\"Advance Due\" AS \"Net cash balance\" FROM {{#188}} d WHERE true [[AND {{position_trend}}]] ORDER BY d.\"Date\"",

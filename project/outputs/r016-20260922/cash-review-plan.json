    {
      "id": 201,
      "name": "Cash position reconciliation · position date",
      "reason": "Existing income cash cards do not provide this all-period net-profit reconciliation.",
      "dataset_query": {
        "stages": [
          {
            "template-tags": [
              {
                "type": "card",
                "id": "r016-model-186",
                "name": "#186",

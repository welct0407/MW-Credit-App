                "display-name": "Cash Position by Date",
                "card-id": 188
              },
              {
                "snippet-name": "Income statement period",
                "id": "r016-income-snippet",
                "name": "snippet: Income statement period",
                "display-name": "Income statement period",
                "type": "snippet",
                "snippet-id": 2
              },
              {
                "widget-type": "date/all-options",
                "id": "r016-statement-period",
                "name": "statement_period",
                "display-name": "Statement period",
                "type": "dimension",
                "dimension": [
                  "field",
                  {
                    "base-type": "type/Date",
                    "lib/uuid": "977504ba-5fef-4918-8f30-0062e3a73094",
                    "effective-type": "type/Date"
                  },
                  82
                ],
                "alias": "d.\"Date\""
              },
              {
                "type": "card",
                "id": "r016-model-187",
                "name": "#187",
                "display-name": "Cash Accounts by Date",
                "card-id": 187
              }
            ],
            "lib/type": "mbql.stage/native",
            "native": "WITH statement AS ({{snippet: Income statement period}}) SELECT v.component AS \"Component\",v.amount AS \"Amount\" FROM statement s JOIN {{#188}} c ON c.\"Date\"=s.\"Period End\" CROSS JOIN LATERAL (VALUES (1,'Remaining lending capital',c.\"Cash Pool Remaining\"),(2,'+ Retained net profit · all periods',c.\"Retained Profit Through Date\"),(3,'+ Reconciliation difference',c.\"Cash Reconciliation Difference\"),(4,'= Net cash balance',c.\"Business Cash Held\"-c.\"Advance Due\"),(5,'+ Partner advances',c.\"Advance Due\"),(6,'= Business cash held',c.\"Business Cash Held\")) v(step,component,amount) ORDER BY v.step"
          }
        ],
        "lib/type": "mbql/query",
        "database": 2
      },
      "visualization_settings": {
        "table.pivot": false,
        "column_settings": {
          "[\"name\",\"Amount\"]": {
            "number_style": "decimal",
            "decimals": 0,
            "number_separators": ".,",
            "compact": false

            "comment": null,
            "view_definition": " WITH raw AS (\n         SELECT i_1.borrower_id,\n            i_1.loan_id,\n            i_1.reporting_date,\n            LEAST((i_1.reporting_date + '3 mons'::interval)::date, i_1.reporting_date + 93) AS horizon_end,\n            s.due_date,\n            s.origin,\n            s.bucket,\n            s.principal,\n            s.interest,\n            s.eligible,\n            s.issue\n           FROM reporting_forecast_inputs_v1 i_1\n             LEFT JOIN LATERAL forecast_schedule_v1(i_1.loan, i_1.charges, i_1.reporting_date, LEAST((i_1.reporting_date + '3 mons'::interval)::date, i_1.reporting_date + 93)) s(due_date, origin, bucket, principal, interest, eligible, issue) ON true\n        ), issues AS (\n         SELECT raw.borrower_id,\n            count(DISTINCT raw.loan_id) FILTER (WHERE raw.origin = 'Notice'::text AND raw.bucket = 'Recorded plan only'::text)::integer AS manual_loans,\n            count(DISTINCT raw.loan_id) FILTER (WHERE raw.origin = 'Exception'::text OR raw.origin = 'Recorded'::text AND raw.bucket = 'Recovery only'::text AND raw.due_date > raw.reporting_date)::integer AS review_loans,\n            string_agg(DISTINCT raw.issue, '; '::text ORDER BY raw.issue) FILTER (WHERE raw.origin = 'Exception'::text) AS issue_text,\n            LEAST(count(DISTINCT raw.due_date) FILTER (WHERE raw.due_date > raw.reporting_date AND raw.due_date <= raw.horizon_end AND (raw.principal + raw.interest) > 0::numeric AND (raw.origin = 'Recorded'::text OR raw.origin = 'Simulated'::text AND raw.eligible)), 5::bigint)::integer AS displayed_dates\n           FROM raw\n          GROUP BY raw.borrower_id\n        ), ctx AS (\n         SELECT olap_reporting_date() AS t\n        )\n SELECT b.\"Row ID\",\n    b.\"Row ID\" AS \"Ref Borrower\",\n    ctx.t AS \"As Of Date\",\n    LEAST((ctx.t + '3 mons'::interval)::date, ctx.t + 93) AS \"Horizon End\",\n    statement_timestamp() AS \"Calculated At\",\n    COALESCE(i.displayed_dates, 0) AS \"Displayed Dates\",\n    COALESCE(i.manual_loans, 0) AS \"Recorded Only Loans\",\n    COALESCE(i.review_loans, 0) AS \"Review Loans\",\n    ((\n        CASE\n            WHEN COALESCE(i.review_loans, 0) > 0 THEN 'Incomplete / review required. '::text\n            ELSE ''::text\n        END ||\n        CASE\n            WHEN COALESCE(i.displayed_dates, 0) = 0 THEN 'No upcoming charges within 3 months.'::text\n            ELSE ('Showing '::text || i.displayed_dates) || ' due dates within 3 months.'::text\n        END) ||\n        CASE\n            WHEN COALESCE(i.manual_loans, 0) > 0 THEN ' Auto-off loans: recorded settlement charges only.'::text\n            ELSE ''::text\n        END) ||\n        CASE\n            WHEN i.issue_text IS NOT NULL THEN ' '::text || i.issue_text\n            ELSE ''::text\n        END AS \"Coverage Note\"\n   FROM \"Borrowers\" b\n     CROSS JOIN ctx\n     LEFT JOIN issues i ON i.borrower_id = b.\"Row ID\";",
            "partition_key": null,
            "partition_bound": null,
            "parents": null,
            "extension": null

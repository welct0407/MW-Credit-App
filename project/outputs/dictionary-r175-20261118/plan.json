        "content": {
          "definition": {
            "schema": "public",
            "name": "oltp_upcoming_charge_events_v1",
            "kind": "v",
            "owner": "postgres",
            "row_security": false,
            "force_row_security": false,
            "replica_identity": "n",
            "persistence": "p",
            "is_partition": false,
            "options": null,
            "acl": "{postgres=arwdDxtm/postgres,mw_integration_agent=r/postgres,mw_app_prod=r/postgres,mw_chat_read_prod=r/postgres}",
            "comment": "R048: one loan/date; recorded-first remaining obligations; next seven days union borrower first five dates within three calendar months (max 93 days). Read-only.",
            "view_definition": " WITH raw AS (\n         SELECT i.loan_id,\n            i.borrower_id,\n            i.loan,\n            i.reporting_date,\n            LEAST((i.reporting_date + '3 mons'::interval)::date, i.reporting_date + 93) AS horizon_end,\n            s.due_date,\n            s.origin,\n            s.bucket,\n            s.principal,\n            s.interest,\n            s.eligible,\n            s.issue\n           FROM reporting_forecast_inputs_v1 i\n             JOIN \"Borrowers\" b ON b.\"Row ID\" = i.borrower_id\n             CROSS JOIN LATERAL forecast_schedule_v1(i.loan, i.charges, i.reporting_date, LEAST((i.reporting_date + '3 mons'::interval)::date, i.reporting_date + 93)) s(due_date, origin, bucket, principal, interest, eligible, issue)\n        ), amounts AS (\n         SELECT raw.loan_id,\n            raw.borrower_id,\n            raw.reporting_date,\n            raw.horizon_end,\n            raw.due_date,\n            sum(raw.principal) AS principal,\n            sum(raw.interest) AS interest,\n                CASE\n                    WHEN bool_or(raw.origin = 'Recorded'::text) THEN\n                    CASE\n                        WHEN bool_or(raw.bucket = 'Recovery only'::text) THEN 'Recorded - review status'::text\n                        WHEN bool_and(NOT COALESCE((raw.loan ->> 'auto'::text)::boolean, false)) THEN 'Recorded settlement'::text\n                        ELSE 'Recorded'::text\n                    END\n                    ELSE 'Projected'::text\n                END AS basis\n           FROM raw\n          WHERE raw.due_date > raw.reporting_date AND raw.due_date <= raw.horizon_end AND (raw.principal + raw.interest) > 0::numeric AND (raw.origin = 'Recorded'::text OR raw.origin = 'Simulated'::text AND raw.eligible)\n          GROUP BY raw.loan_id, raw.borrower_id, raw.reporting_date, raw.horizon_end, raw.due_date\n        ), ranked AS (\n         SELECT amounts.loan_id,\n            amounts.borrower_id,\n            amounts.reporting_date,\n            amounts.horizon_end,\n            amounts.due_date,\n            amounts.principal,\n            amounts.interest,\n            amounts.basis,\n            dense_rank() OVER (PARTITION BY amounts.borrower_id ORDER BY amounts.due_date)::integer AS due_rank,\n            COALESCE(( SELECT sum(c.\"Late Charge Remaining\") AS sum\n                   FROM \"Charges\" c\n                  WHERE c.\"Ref Loans\" = amounts.loan_id AND c.\"Charge Date\" = amounts.due_date AND amounts.basis <> 'Projected'::text), 0::numeric) AS late\n           FROM amounts\n        )\n SELECT (((('uf1:'::text || length(loan_id)) || ':'::text) || loan_id) || ':'::text) || to_char(due_date::timestamp with time zone, 'YYYY-MM-DD'::text) AS \"Row ID\",\n    borrower_id AS \"Ref Borrower\",\n    loan_id AS \"Ref Loan\",\n    due_date AS \"Due Date\",\n    principal AS \"Principal Remaining\",\n    interest AS \"Interest Remaining\",\n    principal + interest + late AS \"Amount Remaining\",\n    basis AS \"Basis\",\n    reporting_date AS \"As Of Date\",\n    horizon_end AS \"Horizon End\",\n    statement_timestamp() AS \"Calculated At\",\n    due_date <= (reporting_date + 7) AS \"Within 7 Days\",\n    due_rank AS \"Borrower Due Date Rank\",\n    late AS \"Late Charge Remaining\"\n   FROM ranked\n  WHERE due_date <= (reporting_date + 7) OR due_rank <= 5;",
            "partition_key": null,
            "partition_bound": null,
            "parents": null,
            "extension": null

      "display": "bar",
      "dataset_query": {
        "database": 2,
        "type": "native",
        "native": {
          "query": "SELECT date_trunc('month',activity_date)::date AS \"Month\",CASE WHEN count(*)=0 THEN 0 WHEN bool_and(net_earned IS NOT NULL) THEN sum(net_earned) END AS \"Net earned ฿\",CASE WHEN count(*)=0 THEN 0 WHEN bool_and(completed_payouts IS NOT NULL) THEN sum(completed_payouts) END AS \"Completed payouts ฿\" FROM public.reporting_partner_daily_v1 d WHERE true [[AND {{partner}}]] [[AND {{period}}]] GROUP BY 1 ORDER BY 1",

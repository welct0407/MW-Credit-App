{
  "name": "vm01-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/src/functions.js",
  "scripts": {
    "build": "tsc && node scripts/build-web.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "cloud:status": "node --use-env-proxy dist/scripts/cloud-status.js",
    "package": "npm run build && node scripts/package.mjs",
    "preflight": "node dist/scripts/preflight.js",
    "bootstrap": "node dist/scripts/admin-ledger.js bootstrap",
    "reconcile": "node dist/scripts/admin-ledger.js reconcile"
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "@azure/identity": "4.13.3",
    "@azure/msal-browser": "5.23.0",
    "@azure/storage-blob": "12.34.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.0"
  }
}
